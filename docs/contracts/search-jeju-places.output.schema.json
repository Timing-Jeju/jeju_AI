{
  "$defs": {
    "Coordinates": {
      "additionalProperties": false,
      "properties": {
        "latitude": {
          "maximum": 90,
          "minimum": -90,
          "title": "Latitude",
          "type": "number"
        },
        "longitude": {
          "maximum": 180,
          "minimum": -180,
          "title": "Longitude",
          "type": "number"
        }
      },
      "required": [
        "latitude",
        "longitude"
      ],
      "title": "Coordinates",
      "type": "object"
    },
    "PlaceSummary": {
      "additionalProperties": false,
      "properties": {
        "place_id": {
          "title": "Place Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "category": {
          "title": "Category",
          "type": "string"
        },
        "address": {
          "title": "Address",
          "type": "string"
        },
        "position": {
          "$ref": "#/$defs/Coordinates"
        },
        "verified_entrance_count": {
          "minimum": 0,
          "title": "Verified Entrance Count",
          "type": "integer"
        },
        "source_refs": {
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "title": "Source Refs",
          "type": "array"
        }
      },
      "required": [
        "place_id",
        "name",
        "category",
        "address",
        "position",
        "verified_entrance_count",
        "source_refs"
      ],
      "title": "PlaceSummary",
      "type": "object"
    },
    "SourceRef": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "publication_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Publication Id"
        },
        "source_fact_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Fact Id"
        }
      },
      "required": [
        "source_id"
      ],
      "title": "SourceRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "status": {
      "enum": [
        "success",
        "data_unavailable"
      ],
      "title": "Status",
      "type": "string"
    },
    "places": {
      "default": [],
      "items": {
        "$ref": "#/$defs/PlaceSummary"
      },
      "title": "Places",
      "type": "array"
    },
    "reason_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason Code"
    }
  },
  "required": [
    "status"
  ],
  "title": "SearchPlacesResponse",
  "type": "object"
}
