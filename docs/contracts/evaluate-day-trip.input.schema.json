{
  "$defs": {
    "AccommodationInput": {
      "additionalProperties": false,
      "properties": {
        "place_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Place Id"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "address": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Address"
        },
        "coordinates": {
          "anyOf": [
            {
              "$ref": "#/$defs/Coordinates"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "name"
      ],
      "title": "AccommodationInput",
      "type": "object"
    },
    "ActivitiesOnlyEvaluationInput": {
      "additionalProperties": false,
      "properties": {
        "accommodation": {
          "$ref": "#/$defs/AccommodationInput"
        },
        "activity_window": {
          "$ref": "#/$defs/ActivityWindow"
        },
        "day_boundary": {
          "anyOf": [
            {
              "$ref": "#/$defs/DayBoundary"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "place_duration_preferences": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PlaceDurationPreference"
          },
          "maxItems": 40,
          "title": "Place Duration Preferences",
          "type": "array"
        },
        "schema_version": {
          "const": "0.7.0",
          "default": "0.7.0",
          "title": "Schema Version",
          "type": "string"
        },
        "trip_date": {
          "format": "date",
          "title": "Trip Date",
          "type": "string"
        },
        "timezone": {
          "const": "Asia/Seoul",
          "default": "Asia/Seoul",
          "title": "Timezone",
          "type": "string"
        },
        "party": {
          "$ref": "#/$defs/Party"
        },
        "transport": {
          "$ref": "#/$defs/TransportPreferences"
        },
        "walking": {
          "$ref": "#/$defs/WalkingPreferences"
        },
        "rest": {
          "$ref": "#/$defs/RestPreferences"
        },
        "food": {
          "$ref": "#/$defs/FoodPreferences"
        },
        "total_budget_krw": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Budget Krw"
        },
        "schedule_format": {
          "const": "activities_only",
          "title": "Schedule Format",
          "type": "string"
        },
        "start_location": {
          "anyOf": [
            {
              "$ref": "#/$defs/PlaceReference"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "scheduled_activities": {
          "items": {
            "$ref": "#/$defs/ScheduledActivity"
          },
          "title": "Scheduled Activities",
          "type": "array"
        },
        "leg_constraints": {
          "default": [],
          "items": {
            "$ref": "#/$defs/LegConstraint"
          },
          "title": "Leg Constraints",
          "type": "array"
        }
      },
      "required": [
        "accommodation",
        "activity_window",
        "trip_date",
        "schedule_format",
        "scheduled_activities"
      ],
      "title": "ActivitiesOnlyEvaluationInput",
      "type": "object"
    },
    "ActivityWindow": {
      "additionalProperties": false,
      "properties": {
        "start_at": {
          "format": "date-time",
          "title": "Start At",
          "type": "string"
        },
        "end_at": {
          "format": "date-time",
          "title": "End At",
          "type": "string"
        }
      },
      "required": [
        "start_at",
        "end_at"
      ],
      "title": "ActivityWindow",
      "type": "object"
    },
    "BusRide": {
      "additionalProperties": false,
      "properties": {
        "canonical_boarding_stop_id": {
          "title": "Canonical Boarding Stop Id",
          "type": "string"
        },
        "provider_boarding_stop_id": {
          "title": "Provider Boarding Stop Id",
          "type": "string"
        },
        "boarding_stop_name": {
          "title": "Boarding Stop Name",
          "type": "string"
        },
        "boarding_stop_position": {
          "$ref": "#/$defs/Coordinates"
        },
        "boarding_direction": {
          "title": "Boarding Direction",
          "type": "string"
        },
        "canonical_alighting_stop_id": {
          "title": "Canonical Alighting Stop Id",
          "type": "string"
        },
        "provider_alighting_stop_id": {
          "title": "Provider Alighting Stop Id",
          "type": "string"
        },
        "alighting_stop_name": {
          "title": "Alighting Stop Name",
          "type": "string"
        },
        "alighting_stop_position": {
          "$ref": "#/$defs/Coordinates"
        },
        "route_id": {
          "title": "Route Id",
          "type": "string"
        },
        "route_number": {
          "title": "Route Number",
          "type": "string"
        },
        "scheduled_departure_at": {
          "format": "date-time",
          "title": "Scheduled Departure At",
          "type": "string"
        },
        "scheduled_arrival_at": {
          "format": "date-time",
          "title": "Scheduled Arrival At",
          "type": "string"
        },
        "recommended_stop_arrival_at": {
          "format": "date-time",
          "title": "Recommended Stop Arrival At",
          "type": "string"
        },
        "boarding_buffer_minutes": {
          "exclusiveMinimum": 0,
          "title": "Boarding Buffer Minutes",
          "type": "integer"
        },
        "mapping_status": {
          "const": "CONFIRMED",
          "title": "Mapping Status",
          "type": "string"
        },
        "distance_meters": {
          "default": 0,
          "minimum": 0,
          "title": "Distance Meters",
          "type": "integer"
        },
        "route_stop_polyline_estimate": {
          "default": true,
          "title": "Route Stop Polyline Estimate",
          "type": "boolean"
        },
        "distance_derivation_fact_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Distance Derivation Fact Ids",
          "type": "array"
        },
        "evidence_fact_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Fact Ids",
          "type": "array"
        }
      },
      "required": [
        "canonical_boarding_stop_id",
        "provider_boarding_stop_id",
        "boarding_stop_name",
        "boarding_stop_position",
        "boarding_direction",
        "canonical_alighting_stop_id",
        "provider_alighting_stop_id",
        "alighting_stop_name",
        "alighting_stop_position",
        "route_id",
        "route_number",
        "scheduled_departure_at",
        "scheduled_arrival_at",
        "recommended_stop_arrival_at",
        "boarding_buffer_minutes",
        "mapping_status",
        "evidence_fact_ids"
      ],
      "title": "BusRide",
      "type": "object"
    },
    "Coordinates": {
      "additionalProperties": false,
      "properties": {
        "latitude": {
          "maximum": 90,
          "minimum": -90,
          "title": "Latitude",
          "type": "number"
        },
        "longitude": {
          "maximum": 180,
          "minimum": -180,
          "title": "Longitude",
          "type": "number"
        }
      },
      "required": [
        "latitude",
        "longitude"
      ],
      "title": "Coordinates",
      "type": "object"
    },
    "CostRange": {
      "additionalProperties": false,
      "properties": {
        "min_krw": {
          "minimum": 0,
          "title": "Min Krw",
          "type": "integer"
        },
        "max_krw": {
          "minimum": 0,
          "title": "Max Krw",
          "type": "integer"
        },
        "is_estimated": {
          "title": "Is Estimated",
          "type": "boolean"
        }
      },
      "required": [
        "min_krw",
        "max_krw",
        "is_estimated"
      ],
      "title": "CostRange",
      "type": "object"
    },
    "DayBoundary": {
      "additionalProperties": false,
      "description": "숙소 왕복으로 제한하지 않는 하루의 canonical 시작·종료 장소.",
      "properties": {
        "start_place": {
          "$ref": "#/$defs/PlaceReference"
        },
        "end_place": {
          "$ref": "#/$defs/PlaceReference"
        }
      },
      "required": [
        "start_place",
        "end_place"
      ],
      "title": "DayBoundary",
      "type": "object"
    },
    "EndpointBasis": {
      "enum": [
        "VERIFIED_ENTRANCE",
        "REPRESENTATIVE_PLACE_POINT",
        "CONFIRMED_STOP",
        "CURRENT_GPS"
      ],
      "title": "EndpointBasis",
      "type": "string"
    },
    "FoodPreferences": {
      "additionalProperties": false,
      "properties": {
        "auto_schedule_meals": {
          "default": true,
          "title": "Auto Schedule Meals",
          "type": "boolean"
        },
        "auto_schedule_cafe": {
          "default": true,
          "title": "Auto Schedule Cafe",
          "type": "boolean"
        },
        "excluded_foods": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Excluded Foods",
          "type": "array"
        },
        "allergens": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Allergens",
          "type": "array"
        },
        "preferred_cuisines": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Preferred Cuisines",
          "type": "array"
        }
      },
      "title": "FoodPreferences",
      "type": "object"
    },
    "FullTimelineActivity": {
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "minLength": 1,
          "title": "Event Id",
          "type": "string"
        },
        "type": {
          "enum": [
            "visit",
            "meal",
            "rest"
          ],
          "title": "Type",
          "type": "string"
        },
        "start_at": {
          "format": "date-time",
          "title": "Start At",
          "type": "string"
        },
        "end_at": {
          "format": "date-time",
          "title": "End At",
          "type": "string"
        },
        "place": {
          "$ref": "#/$defs/PlaceReference"
        },
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        }
      },
      "required": [
        "event_id",
        "type",
        "start_at",
        "end_at",
        "place"
      ],
      "title": "FullTimelineActivity",
      "type": "object"
    },
    "FullTimelineBuffer": {
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "minLength": 1,
          "title": "Event Id",
          "type": "string"
        },
        "type": {
          "const": "buffer",
          "title": "Type",
          "type": "string"
        },
        "start_at": {
          "format": "date-time",
          "title": "Start At",
          "type": "string"
        },
        "end_at": {
          "format": "date-time",
          "title": "End At",
          "type": "string"
        },
        "place": {
          "anyOf": [
            {
              "$ref": "#/$defs/PlaceReference"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reason_code": {
          "title": "Reason Code",
          "type": "string"
        },
        "evidence_fact_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Evidence Fact Ids",
          "type": "array"
        }
      },
      "required": [
        "event_id",
        "type",
        "start_at",
        "end_at",
        "reason_code"
      ],
      "title": "FullTimelineBuffer",
      "type": "object"
    },
    "FullTimelineEvaluationInput": {
      "additionalProperties": false,
      "properties": {
        "accommodation": {
          "$ref": "#/$defs/AccommodationInput"
        },
        "activity_window": {
          "$ref": "#/$defs/ActivityWindow"
        },
        "day_boundary": {
          "anyOf": [
            {
              "$ref": "#/$defs/DayBoundary"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "place_duration_preferences": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PlaceDurationPreference"
          },
          "maxItems": 40,
          "title": "Place Duration Preferences",
          "type": "array"
        },
        "schema_version": {
          "const": "0.7.0",
          "default": "0.7.0",
          "title": "Schema Version",
          "type": "string"
        },
        "trip_date": {
          "format": "date",
          "title": "Trip Date",
          "type": "string"
        },
        "timezone": {
          "const": "Asia/Seoul",
          "default": "Asia/Seoul",
          "title": "Timezone",
          "type": "string"
        },
        "party": {
          "$ref": "#/$defs/Party"
        },
        "transport": {
          "$ref": "#/$defs/TransportPreferences"
        },
        "walking": {
          "$ref": "#/$defs/WalkingPreferences"
        },
        "rest": {
          "$ref": "#/$defs/RestPreferences"
        },
        "food": {
          "$ref": "#/$defs/FoodPreferences"
        },
        "total_budget_krw": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Budget Krw"
        },
        "schedule_format": {
          "const": "full_timeline",
          "title": "Schedule Format",
          "type": "string"
        },
        "timeline": {
          "items": {
            "discriminator": {
              "mapping": {
                "buffer": "#/$defs/FullTimelineBuffer",
                "meal": "#/$defs/FullTimelineActivity",
                "rest": "#/$defs/FullTimelineActivity",
                "transfer": "#/$defs/FullTimelineTransfer",
                "visit": "#/$defs/FullTimelineActivity"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/FullTimelineActivity"
              },
              {
                "$ref": "#/$defs/FullTimelineTransfer"
              },
              {
                "$ref": "#/$defs/FullTimelineBuffer"
              }
            ]
          },
          "title": "Timeline",
          "type": "array"
        }
      },
      "required": [
        "accommodation",
        "activity_window",
        "trip_date",
        "schedule_format",
        "timeline"
      ],
      "title": "FullTimelineEvaluationInput",
      "type": "object"
    },
    "FullTimelineTransfer": {
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "minLength": 1,
          "title": "Event Id",
          "type": "string"
        },
        "type": {
          "const": "transfer",
          "title": "Type",
          "type": "string"
        },
        "start_at": {
          "format": "date-time",
          "title": "Start At",
          "type": "string"
        },
        "end_at": {
          "format": "date-time",
          "title": "End At",
          "type": "string"
        },
        "from_place": {
          "$ref": "#/$defs/PlaceReference"
        },
        "to_place": {
          "$ref": "#/$defs/PlaceReference"
        },
        "planned_mode": {
          "enum": [
            "walk",
            "bus",
            "taxi"
          ],
          "title": "Planned Mode",
          "type": "string"
        },
        "planned_route_number": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Planned Route Number"
        },
        "planned_route_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Planned Route Id"
        },
        "planned_boarding_stop_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Planned Boarding Stop Id"
        },
        "planned_alighting_stop_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Planned Alighting Stop Id"
        },
        "scheduled_departure_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scheduled Departure At"
        },
        "scheduled_arrival_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scheduled Arrival At"
        },
        "planned_distance_meters": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Planned Distance Meters"
        },
        "route_alternatives": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RouteAlternativeSummary"
          },
          "title": "Route Alternatives",
          "type": "array"
        },
        "mode_decision": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModeDecision"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "selected_transfer": {
          "anyOf": [
            {
              "$ref": "#/$defs/Transfer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "evidence_fact_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Evidence Fact Ids",
          "type": "array"
        }
      },
      "required": [
        "event_id",
        "type",
        "start_at",
        "end_at",
        "from_place",
        "to_place",
        "planned_mode"
      ],
      "title": "FullTimelineTransfer",
      "type": "object"
    },
    "LegConstraint": {
      "additionalProperties": false,
      "properties": {
        "from_event_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "From Event Id"
        },
        "to_event_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "To Event Id"
        },
        "locked_mode": {
          "anyOf": [
            {
              "enum": [
                "walk",
                "bus",
                "taxi"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Locked Mode"
        }
      },
      "required": [
        "from_event_id",
        "to_event_id"
      ],
      "title": "LegConstraint",
      "type": "object"
    },
    "ModeDecision": {
      "additionalProperties": false,
      "description": "수단 선택의 정책 입력과 검증 결과를 보존한다.",
      "properties": {
        "policy_id": {
          "default": "service-priority-v1",
          "enum": [
            "service-priority-v1",
            "cost-time-balance-v1"
          ],
          "title": "Policy Id",
          "type": "string"
        },
        "selected_mode": {
          "enum": [
            "walk",
            "bus",
            "taxi"
          ],
          "title": "Selected Mode",
          "type": "string"
        },
        "origin_basis": {
          "$ref": "#/$defs/EndpointBasis"
        },
        "destination_basis": {
          "$ref": "#/$defs/EndpointBasis"
        },
        "context": {
          "default": "generation",
          "enum": [
            "generation",
            "revalidation"
          ],
          "title": "Context",
          "type": "string"
        },
        "walk_threshold_minutes": {
          "default": 15,
          "minimum": 0,
          "title": "Walk Threshold Minutes",
          "type": "integer"
        },
        "bus_wait_threshold_minutes": {
          "default": 30,
          "minimum": 0,
          "title": "Bus Wait Threshold Minutes",
          "type": "integer"
        },
        "max_bus_extra_minutes": {
          "default": 30,
          "minimum": 0,
          "title": "Max Bus Extra Minutes",
          "type": "integer"
        },
        "min_bus_savings_krw": {
          "default": 5000,
          "minimum": 0,
          "title": "Min Bus Savings Krw",
          "type": "integer"
        },
        "planned_walk_minutes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Planned Walk Minutes"
        },
        "bus_wait_minutes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bus Wait Minutes"
        },
        "bus_door_to_door_minutes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bus Door To Door Minutes"
        },
        "taxi_pickup_buffer_minutes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Taxi Pickup Buffer Minutes"
        },
        "taxi_driving_minutes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Taxi Driving Minutes"
        },
        "taxi_door_to_door_minutes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Taxi Door To Door Minutes"
        },
        "bus_cost": {
          "anyOf": [
            {
              "$ref": "#/$defs/CostRange"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "taxi_cost": {
          "anyOf": [
            {
              "$ref": "#/$defs/CostRange"
