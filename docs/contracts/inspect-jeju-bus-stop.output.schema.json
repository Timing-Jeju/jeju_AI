    },
    "name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Name"
    },
    "direction_text": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
