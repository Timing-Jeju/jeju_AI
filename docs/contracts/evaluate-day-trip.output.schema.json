        "segment_evaluations": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SegmentEvaluation"
          },
          "title": "Segment Evaluations",
          "type": "array"
        },
        "activity_evaluations": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ActivityEvaluation"
          },
          "title": "Activity Evaluations",
          "type": "array"
        },
        "repair_options": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RepairOption"
          },
          "title": "Repair Options",
          "type": "array"
        },
        "evidence_facts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EvidenceFact"
          },
          "title": "Evidence Facts",
          "type": "array"
        },
        "data_sources": {
          "default": [],
          "items": {
            "$ref": "#/$defs/DataSourceMetadata"
          },
          "title": "Data Sources",
          "type": "array"
        },
        "validation": {
          "$ref": "#/$defs/ValidationSummary"
        },
        "failure": {
          "anyOf": [
            {
              "$ref": "#/$defs/Failure"
            },
            {
              "type": "null"
