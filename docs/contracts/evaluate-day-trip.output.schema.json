    "EvaluationResponse": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.7.0",
          "default": "0.7.0",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "enum": [
            "feasible",
            "feasible_with_caution",
            "infeasible",
            "unverifiable"
          ],
          "title": "Status",
          "type": "string"
        },
        "timing_status": {
          "enum": [
            "on_schedule",
            "at_risk",
            "disrupted",
            "unknown"
          ],
          "title": "Timing Status",
          "type": "string"
        },
        "evidence_status": {
          "enum": [
            "verified",
            "partial",
            "unavailable"
          ],
          "title": "Evidence Status",
          "type": "string"
        },
        "overall_risk": {
          "enum": [
            "critical",
            "high",
            "medium",
            "low",
            "unknown"
          ],
          "title": "Overall Risk",
          "type": "string"
