        "schedule_window_fit": {
          "default": false,
          "title": "Schedule Window Fit",
          "type": "boolean"
        },
        "normalized_schedule": {
          "$ref": "#/$defs/NormalizedSchedule"
        },
        "issues": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EvaluationIssue"
          },
          "title": "Issues",
          "type": "array"
